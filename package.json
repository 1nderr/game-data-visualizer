{
  "name": "game-data-visualizer",
  "version": "1.0.0",
  "description": "A visualization tool for my games.csv data",
  "license": "ISC",
  "author": "1nder",
  "type": "module",
  "main": "app.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist/",
    "lint": "eslint --fix --max-warnings 0",
    "format": "prettier --write .",
    "start": "npm run build && node ./dist/app.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml}": "prettier --write"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "csv-parse": "^7.0.3",
    "zod": "^4.6.7"
  }
}
